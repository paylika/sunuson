{
  "name": "sunu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "// build": "NE JAMAIS pointer sur opennextjs-cloudflare : OpenNext appelle lui-même `npm run build` pour construire l'app Next.js, ce qui crée une récursion infinie jusqu'au timeout du CI.",
    "prebuild": "node scripts/check-icons.mjs && node scripts/check-server-exports.mjs",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "next lint",
    "cf:typegen": "wrangler types",
    "// cf:size": "Verifie que le Worker tient sous la limite de 3 Mio compressés du plan gratuit, sans deployer. A lancer apres `npm run cf:build`.",
    "cf:size": "wrangler deploy --dry-run",
    "icons": "node scripts/icons-build.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:inspect": "node scripts/db-inspect.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "wrangler": "^4.123.0"
  }
}
