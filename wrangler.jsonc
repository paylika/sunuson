{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ⚠️ Ce nom devient celui du Worker. Vérifie qu'aucun de tes projets
  // Cloudflare ne s'appelle déjà comme ça, sinon le déploiement l'écraserait.
  "name": "sunuson",

  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // La base est chez Supabase, pas ici : le client parle en HTTP, ce qui
  // fonctionne nativement sur Workers. Pas de binding D1.
  //
  // Avant de déployer, pousser les variables côté Cloudflare :
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // et déclarer les NEXT_PUBLIC_* dans "vars" ci-dessous — elles sont
  // publiques par nature, elles finissent dans le bundle du navigateur.
  "vars": {
    // "NEXT_PUBLIC_SUPABASE_URL": "https://xxxx.supabase.co",
    // "NEXT_PUBLIC_SUPABASE_ANON_KEY": "...",
    // "NEXT_PUBLIC_AUDIO_BASE_URL": "..."
  },

  // Les fichiers audio, le jour où l'egress Supabase serre.
  // Egress gratuit : c'est le seul poste qui explose sur un produit d'écoute.
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "sunuson-audio"
    }
  ]
}
