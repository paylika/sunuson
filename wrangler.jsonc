{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ⚠️ Ce nom devient celui du Worker. Vérifie qu'aucun de tes projets
  // Cloudflare ne s'appelle déjà comme ça, sinon le déploiement l'écraserait.
  "name": "sunuson",

  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": { "enabled": true },

  // Variables NON secretes, ecrites ici volontairement.
  //
  // wrangler REMPLACE les variables du tableau de bord par celles-ci a chaque
  // deploiement : un bloc vide les effacait, et le Worker tournait sans savoir
  // ou etait la base. Les declarer dans le code les rend deterministes.
  //
  // La cle anon est concue pour etre publique — elle part dans le navigateur
  // sur toute application Supabase, et c'est la RLS qui protege les donnees.
  // Les vrais secrets (service_role, webhook) restent des Secrets Cloudflare :
  // wrangler n'y touche pas.
  "vars": {
    "SUPABASE_URL": "https://zzlloccetjzfmrsffcqh.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp6bGxvY2NldGp6Zm1yc2ZmY3FoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5NTg0OTEsImV4cCI6MjEwMjUzNDQ5MX0.V60WoD8wvnv_qodqhD4rcFkpcgD5tbufmPmWRuL2jKY"
  }

  // Pas de binding R2 pour l'instant : les fichiers vivent dans Supabase
  // Storage. Déclarer un bucket R2 sans avoir activé R2 sur le compte fait
  // échouer le déploiement avec « Please enable R2 » [code: 10042].
  //
  // Le jour où l'egress Supabase serre (~5 Go/mois, soit ~1 200 écoutes),
  // activer R2 dans le tableau de bord, créer le bucket, puis rétablir :
  //
  //   "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "sunuson-audio" }]
  //
  // Côté code, seul AUDIO_BASE_URL change : audio_key reste identique.
}
