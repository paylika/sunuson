# Copier en .env.local et renseigner. .env.local n'est jamais committé.
# Supabase : Dashboard > Project Settings > API
#
# Aucune variable n'est préfixée NEXT_PUBLIC_, et c'est voulu : Next fige les
# NEXT_PUBLIC_ au moment du build. Sans préfixe, elles sont lues à l'exécution,
# ce qui permet de les définir côté hébergeur sans rebuilder.
# Elles ne sont de toute façon lues que côté serveur.

SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Clé « anon public ». Bridée par la RLS — l'app s'en sert pour TOUTES les
# lectures, même côté serveur.
SUPABASE_ANON_KEY=""

# Clé « service_role secret ». Elle CONTOURNE toute la RLS.
# Uniquement pour le seed et le webhook de paiement.
# Jamais committée, jamais collée dans un chat.
SUPABASE_SERVICE_ROLE_KEY=""

# Secret partagé avec l'agrégateur de paiement. Sans lui, /api/paiement/webhook
# répond 503 : aucun soutien ne peut être confirmé.
PAYMENT_WEBHOOK_SECRET=""

# Domaine public du bucket audio (Supabase Storage puis Cloudflare R2).
# Optionnel : sans lui, les morceaux sans fichier sont simplement simulés.
AUDIO_BASE_URL=""

# ------------------------------------------------------------- paiement
#
# Tant que PAYMENT_PROVIDER n'est pas renseigné, l'application reste en mode
# démonstration : le soutien se confirme tout seul en développement et aucun
# argent ne circule. Le jour où tu branches un agrégateur, mets "paydunya" et
# renseigne les trois clés — l'application bascule seule sur le vrai flux.
# "intech", "paydunya", ou vide pour rester en démonstration.
PAYMENT_PROVIDER=""

# ----------------------------------------------------------- IntechPay
#
# À recopier depuis l'intégration qui fonctionne déjà dans Paylika : l'adresse
# de l'API et le format des clés y sont éprouvés, ce qui évite de les deviner.
INTECH_API_URL=""
INTECH_API_KEY=""
INTECH_MERCHANT_ID=""

# Vérifie la notification de paiement. Deux formes acceptées : le secret
# partagé tel quel dans un en-tête, ou une empreinte HMAC-SHA256 du corps.
# SANS CETTE VALEUR, TOUTE NOTIFICATION EST REFUSÉE — c'est voulu : un webhook
# non vérifié laisse n'importe qui déclarer un soutien comme payé.
INTECH_WEBHOOK_SECRET=""

# ----------------------------------------------------------- PayDunya

# Laisse vide pour le bac à sable. "live" encaisse de vrais francs.
PAYDUNYA_MODE=""
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""

# Adresse publique du site : l'agrégateur y renvoie le fan après paiement.
# Elle doit être joignable depuis l'extérieur, donc pas localhost.
SITE_URL=""

# Nom affiché par l'agrégateur pendant le paiement.
PAYMENT_STORE_NAME="Amplifan"
