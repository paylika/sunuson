# Copier en .env.local et renseigner. .env.local n'est jamais committé.
# Supabase : Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Clé publique (anon). Bridée par la RLS — l'app s'en sert pour TOUTES les
# lectures, même côté serveur. Sans danger si elle se retrouve dans le
# navigateur, c'est prévu pour.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé secrète (service_role). Elle CONTOURNE toute la RLS.
# Uniquement pour le seed et le futur webhook de paiement.
# Jamais préfixée NEXT_PUBLIC_, jamais committée, jamais collée dans un chat.
SUPABASE_SERVICE_ROLE_KEY=""

# Domaine public du bucket audio (Supabase Storage puis Cloudflare R2).
# Optionnel : sans lui, les morceaux sans fichier sont simplement simulés.
NEXT_PUBLIC_AUDIO_BASE_URL=""
