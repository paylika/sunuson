# Copier en .env.local et renseigner. .env.local n'est jamais committé.
# Supabase : Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Clé publique — peut apparaître dans le navigateur, elle est bridée par la RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé secrète — elle CONTOURNE toute la RLS. Serveur uniquement, jamais
# préfixée NEXT_PUBLIC_, jamais committée, jamais collée dans un chat.
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare R2 — domaine public du bucket audio. Optionnel tant qu'aucun
# fichier n'est déposé : les morceaux sans audio sont simplement simulés.
NEXT_PUBLIC_AUDIO_BASE_URL=""
