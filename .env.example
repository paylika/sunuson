# Copier en .env.local et renseigner. .env.local n'est jamais committé.

# Neon — Dashboard > ton projet > Connection string (pooled)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Cloudflare R2 — domaine public du bucket audio. Optionnel tant qu'aucun
# fichier n'est déposé : les morceaux sans audio sont simplement simulés.
NEXT_PUBLIC_AUDIO_BASE_URL=""
